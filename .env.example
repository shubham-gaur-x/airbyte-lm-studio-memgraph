# LM Studio (local — must be running on Mac with gemma3:12b loaded)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=gemma3-12b
# Embedding model for vector search — must also be loaded in LM Studio
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Local Postgres (Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=meeting_memory
POSTGRES_USER=meeting_user
POSTGRES_PASSWORD=changeme

# Local Memgraph (Docker — leave blank if no auth)
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Jira — set these to YOUR OWN Jira Cloud site, not a teammate's. A token+email
# mismatch just fails auth safely, but leaving these unset from a teammate's copy is
# a common mistake, so there is no working default here on purpose.
JIRA_ENABLED=true
JIRA_DOMAIN=your-site.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1
JIRA_ISSUE_TYPE=Task
JIRA_CONFIDENCE_THRESHOLD=0.6           # P4: ActionItems below this become needs_review, not a ticket
JIRA_DEDUP_ENABLED=true                 # P5: dedup recurring action items instead of duplicate tickets
JIRA_DEDUP_THRESHOLD=0.9                # P5: min similarity to treat as a duplicate
PERSON_ROSTER_PATH=                     # P3: JSON roster for entity resolution (empty = none, see sample_data/roster.example.json)

# Airbyte Cloud (ELT connectors — Gmail/Calendar/Jira sources). Needed only if you run
# scripts/setup_airbyte.py or scripts/update_bore_port.py; the pipeline itself reads
# from Postgres and does not call the Airbyte API directly.
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_ACCESS_TOKEN=                   # alternative to the client id/secret pair above
AIRBYTE_WEBHOOK_SECRET=

# Action Agent (Airbyte Agents SDK — app.airbyte.ai, org Onix; different product
# from the AIRBYTE_CLIENT_ID/SECRET pair above, which is Airbyte Cloud ELT)
ACTION_AGENT_ENABLED=true
ACTION_AGENT_BATCH_SIZE=5
AIRBYTE_AGENTS_CLIENT_ID=
AIRBYTE_AGENTS_CLIENT_SECRET=
AIRBYTE_AGENTS_CONNECTOR_ID=
AIRBYTE_AGENTS_ORGANIZATION_ID=

# Google Meet transcript capture (P1) + Calendar OAuth refresh — optional, needs GCP
# creds; the pipeline runs fine without these (transcript ingestion just no-ops).
# See docs/V5_1_EXTERNAL_WIRING_RUNBOOKS.md for the full GCP setup.
GOOGLE_ACCESS_TOKEN=
MEET_PUBSUB_SUBSCRIPTION=               # projects/<p>/subscriptions/<s> (PULL subscription)
MEET_CLIENT_ID=
MEET_CLIENT_SECRET=
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=

# Access control (optional — leave unset to skip scope enforcement)
ACCESS_POLICY_FILE=
FACT_MIN_CONFIDENCE=0.5                 # read-time floor in person_memory_profile

# Service
PORT=8000
LOG_LEVEL=INFO

# Dev Agent (autonomous Jira ticket implementer — see docs/DEV_AGENT.md)
# GITHUB_OWNER/REPO — set these to YOUR OWN fork/repo. If you have collaborator access
# to someone else's repo and leave their values here, the dev agent will clone, push
# branches, and open real PRs against THEIR repo using your token. There is no working
# default here on purpose.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_WEBHOOK_SECRET=                  # P2 /webhook/github HMAC secret (unset = accept, dev only)
LM_STUDIO_ANTHROPIC_URL=http://host.docker.internal:1234
# Coding-backend toggle. Default local (LM Studio, $0). Hosted values are an opt-in
# exception for other users, applying ONLY to dev-agent code work (never extraction).
DEV_AGENT_LLM_BACKEND=local            # local | claude | openrouter | gemini | groq
DEV_AGENT_MIN_CONTEXT=32768            # preflight fails fast below this loaded context
DEV_AGENT_LM_MODEL=qwen2.5-coder-7b-instruct   # local coder model; load in LM Studio at 32k ctx. The runner pins ANTHROPIC_MODEL + ANTHROPIC_SMALL_FAST_MODEL to this so JIT never evicts it.
# Hosted-backend keys (all optional; only set the one you use):
ANTHROPIC_API_KEY=                     # required only when DEV_AGENT_LLM_BACKEND=claude
ANTHROPIC_BASE_URL=                    # optional override, defaults to https://api.anthropic.com
DEV_AGENT_CLAUDE_MODEL=                # optional, DEV_AGENT_LLM_BACKEND=claude: pin a specific
                                        # model for cost control (e.g. claude-haiku-4-5). Empty = default.
OPENROUTER_API_KEY=                    # DEV_AGENT_LLM_BACKEND=openrouter (via litellm proxy)
GEMINI_API_KEY=                        # DEV_AGENT_LLM_BACKEND=gemini
GROQ_API_KEY=                          # DEV_AGENT_LLM_BACKEND=groq
LITELLM_PROXY_URL=http://litellm:4000  # hosted tiers route through here
DEV_AGENT_VERIFY_THRESHOLD=0.6         # P8 self-verify: min confidence to count as "addresses ticket"
DEV_AGENT_VERIFY_TIMEOUT_SECONDS=180   # P8 self-verify: one-shot scoring call timeout
DEV_AGENT_REQUIRE_LABELS=dev-agent     # only tickets with this label are eligible (guardrail)
DEV_AGENT_TODO_STATUS=To Do
DEV_AGENT_IN_PROGRESS_STATUS=In Progress
DEV_AGENT_REVIEW_STATUS=In Review
DEV_AGENT_SKIP_LABELS=meeting-action-item
DEV_AGENT_POLL_MINUTES=10
DEV_AGENT_BATCH_SIZE=5
DEV_AGENT_MAX_TURNS=40
DEV_AGENT_TIMEOUT_SECONDS=1800
DEV_AGENT_MAX_ATTEMPTS=1
DEV_AGENT_GIT_NAME=Meeting Memory Dev Agent
DEV_AGENT_GIT_EMAIL=dev-agent@local
